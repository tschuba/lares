# WeeWX Configuration Template for Lares
# Copy this file to weewx.conf and replace placeholders with actual values

# Station Configuration
[Station]
    station_type = MQTTSubscribe

    # MQTT-Subscribe Driver Configuration
    [[MQTTSubscribe]]
        # MQTT Broker Connection
        broker = 192.168.178.163
        port = 1883
        username = $MQTT_USERNAME
        password = $MQTT_PASSWORD

        # Topic to subscribe to for Ecowitt weather data
        # Adjust topic based on Ecowitt integration option:
        # - Option A (direct MQTT): Topic as configured in Ecowitt App
        # - Option B (ecowitt2mqtt): weather/ecowitt/#
        topic = weather/ecowitt/#

        # Optional: MQTT connection options
        # client_id = weewx
        # qos = 0
        # retain = false

