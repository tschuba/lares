      "description": "Heizkurve: mittlere Rücklauftemperatur (Ist und Soll) je 1-°C-Klasse der Außentemperatur, letzte 30 Tage, nur Heizbetrieb (Zähler runtime_heating steigt; Warmwasser/Stillstand ausgeschlossen). Soll-Werte werden erst seit 08.11.2026 aufgezeichnet.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-nas"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "pointSize": {
              "fixed": 5
            },
            "show": "points"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "temperature_return"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Rücklauf Ist"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "temperature_return_setpoint"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Rücklauf Soll (Heizkurve)"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "import \"math\"\nfrom(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"heating\")\n  |> filter(fn: (r) => r[\"_field\"] == \"runtime_heating\" or r[\"_field\"] == \"temperature_outside\" or r[\"_field\"] == \"temperature_return\")\n  |> aggregateWindow(every: 30m, fn: last, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.runtime_heating and exists r.temperature_outside and exists r.temperature_return)\n  |> sort(columns: [\"_time\"])\n  |> difference(columns: [\"runtime_heating\"])\n  |> filter(fn: (r) => r.runtime_heating > 0)\n  |> map(fn: (r) => ({r with bin: math.round(x: r.temperature_outside)}))\n  |> group(columns: [\"bin\"])\n  |> mean(column: \"temperature_return\")\n  |> group()\n  |> rename(columns: {bin: \"temperature_outside\"})\n  |> keep(columns: [\"temperature_outside\", \"temperature_return\"])\n  |> sort(columns: [\"temperature_outside\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "import \"math\"\nfrom(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"heating\")\n  |> filter(fn: (r) => r[\"_field\"] == \"runtime_heating\" or r[\"_field\"] == \"temperature_outside\" or r[\"_field\"] == \"temperature_return_setpoint\")\n  |> aggregateWindow(every: 30m, fn: last, createEmpty: false)\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => exists r.runtime_heating and exists r.temperature_outside and exists r.temperature_return_setpoint)\n  |> sort(columns: [\"_time\"])\n  |> difference(columns: [\"runtime_heating\"])\n  |> filter(fn: (r) => r.runtime_heating > 0)\n  |> map(fn: (r) => ({r with bin: math.round(x: r.temperature_outside)}))\n  |> group(columns: [\"bin\"])\n  |> mean(column: \"temperature_return_setpoint\")\n  |> group()\n  |> rename(columns: {bin: \"temperature_outside\"})\n  |> keep(columns: [\"temperature_outside\", \"temperature_return_setpoint\"])\n  |> sort(columns: [\"temperature_outside\"])"
        }
      ],
