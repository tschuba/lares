        {
          "refId": "Status",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "import \"internal/debug\"\n\nfrom(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"heating\")\n  |> filter(fn: (r) => r[\"_field\"] == \"compressor_active\" or r[\"_field\"] == \"compressor2_active\" or r[\"_field\"] == \"backup_heater_active\" or r[\"_field\"] == \"backup_heater2_active\" or r[\"_field\"] == \"backup_heater3_active\")\n  |> aggregateWindow(every: v.windowPeriod, fn: max, createEmpty: false)\n  |> map(fn: (r) => ({r with _value: if r._value >= 1.0 then (if r._field == \"compressor_active\" then 1.0 else if r._field == \"compressor2_active\" then 2.0 else if r._field == \"backup_heater_active\" then 3.0 else if r._field == \"backup_heater2_active\" then 4.0 else 5.0) else debug.null(type: \"float\")}))"
