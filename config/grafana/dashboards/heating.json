      "targets": [
        {
          "refId": "HeatEnergy",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "import \"strings\"\nimport \"date\"\n\np = strings.split(v: \"${period}\", t: \"|\")\n\nfrom(bucket: v.defaultBucket)\n  |> range(start: duration(v: \"-\" + p[1]))\n  |> filter(fn: (r) => r[\"_measurement\"] == \"heating\")\n  |> filter(fn: (r) => r[\"_field\"] == \"heat_energy_heating\" or r[\"_field\"] == \"heat_energy_hot_water\")\n  |> aggregateWindow(every: duration(v: p[0]), fn: last, createEmpty: false, offset: duration(v: p[2]))\n  |> difference(nonNegative: true)\n  |> map(fn: (r) => {\n      t = date.sub(d: 1s, from: r._time)\n      months = [\"Jan\", \"Feb\", \"Mär\", \"Apr\", \"Mai\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Okt\", \"Nov\", \"Dez\"]\n      label = if p[0] == \"1w\" then \"KW \" + string(v: date.week(t: t))\n        else if p[0] == \"1mo\" then months[date.month(t: t) - 1] + \" \" + string(v: date.year(t: t) - 2000)\n        else if p[0] == \"3mo\" then \"Q\" + string(v: date.quarter(t: t)) + \" \" + string(v: date.year(t: t))\n        else string(v: date.year(t: t))\n      return {r with label: label}\n    })\n  |> keep(columns: [\"label\", \"_field\", \"_value\"])\n  |> yield(name: \"delta\")"
        }
      ],
      "options": {
        "xField": "label",
        "xTickLabelRotation": 0,
        "showValue": "never",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
