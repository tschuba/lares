      "targets": [
        {
          "refId": "Delta",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "outdoor = from(bucket: v.defaultBucket)\n  |> range(start: -10m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"ventilation\")\n  |> filter(fn: (r) => r[\"metric\"] == \"temperature_outdoor_air\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"outdoor\"})\n\nextract = from(bucket: v.defaultBucket)\n  |> range(start: -10m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"ventilation\")\n  |> filter(fn: (r) => r[\"metric\"] == \"temperature_extract_air\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"extract\"})\n\njoin(tables: {outdoor: outdoor, extract: extract}, on: [\"_time\"])\n  |> map(fn: (r) => ({_time: r._time, _value: r.outdoor - r.extract}))\n  |> last()\n  |> yield(name: \"last\")"
        }
      ]
