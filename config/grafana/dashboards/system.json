        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Docker CPU – Pi",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-nas"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "displayName": "${__field.labels._field}"
        }
      },
      "targets": [
        {
          "refId": "DockerCpuPi",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"docker_container_cpu\")\n  |> filter(fn: (r) => r[\"host\"] == \"pi\")\n  |> filter(fn: (r) => r[\"_field\"] == \"usage_percent\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _field: r.container_name}))\n  |> group(columns: [\"_field\"])\n  |> yield(name: \"mean\")"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Docker Arbeitsspeicher – Pi",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 8,
      "datasource": {
        "type": "influxdb",
