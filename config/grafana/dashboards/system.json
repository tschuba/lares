      "targets": [
        {
          "refId": "DockerMemPi",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"docker_container_mem\")\n  |> filter(fn: (r) => r[\"host\"] == \"pi\")\n  |> filter(fn: (r) => r[\"_field\"] == \"usage_percent\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with _field: r.container_name}))\n  |> group(columns: [\"_field\"])\n  |> yield(name: \"mean\")"
        }
      ]
    },
    {
      "type": "table",
      "title": "Container Status – NAS",
      "id": 9,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-nas"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -10m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"docker_container_status\")\n  |> filter(fn: (r) => r[\"host\"] == \"nas\")\n  |> filter(fn: (r) => r[\"_field\"] == \"uptime_ns\")\n  |> last()\n  |> map(fn: (r) => ({\n      _time: r._time,\n      container: r.container_name,\n      status: r.container_status,\n      image: r.image,\n      uptime_h: float(v: r._value) / 3600000000000.0\n  }))\n  |> keep(columns: [\"_time\", \"container\", \"status\", \"image\", \"uptime_h\"])\n  |> sort(columns: [\"container\"])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "running": {
                        "color": "green",
                        "text": "running",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "color": "red",
                        "text": "stopped",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "uptime_h"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Uptime (h)"
              },
              {
                "id": "unit",
                "value": "h"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "container"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "image"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Image"
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "desc": false,
            "displayName": "container"
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "frameIndex": 0,
        "showHeader": true
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "container",
                "status",
                "image",
                "uptime_h"
              ]
            }
          }
        }
      ]
