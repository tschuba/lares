      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Keine Daten",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "Läuft",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Standby",
                  "color": "yellow",
                  "index": 1
                },
                "0": {
                  "text": "Gestoppt",
                  "color": "gray",
                  "index": 2
                },
                "-1": {
                  "text": "STÖRUNG",
                  "color": "red",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "background",
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"sungrow\" and r[\"_field\"] == \"system_state\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: if r._value == \"Run\" then 2.0 else if r._value == \"Standby\" then 1.0 else if r._value == \"Stop\" then 0.0 else -1.0}))"
        }
      ]
