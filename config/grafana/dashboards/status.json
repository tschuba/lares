          "query": "import \"array\"\n\n// Platzhalter am Zeitraumanfang (-1 = keine Daten), damit das Panel auch ohne Alarm-Feld\n// (Bridge < 1.2.6) einen Zeitverlauf hat statt \"Data does not have a time field\".\nplaceholder = array.from(rows: [{_time: v.timeRangeStart, _value: -1.0}])\n\nreal = from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ventilation\" and r.metric == \"active_alarm_count\")\n  |> aggregateWindow(every: 5m, fn: max, createEmpty: false)\n  |> map(fn: (r) => ({_time: r._time, _value: if r._value > 0.0 then 1.0 else 0.0}))\n  |> keep(columns: [\"_time\", \"_value\"])\n\nunion(tables: [placeholder, real])\n  |> group()\n  |> sort(columns: [\"_time\"])\n  |> rename(columns: {_value: \"Lüftung\"})"
        }
