        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"sungrow\" and r._field == \"total_active_power\")\n  |> aggregateWindow(every: 5m, fn: count, createEmpty: true)\n  |> map(fn: (r) => ({_time: r._time, \"Sungrow\": if r._value > 0 then 1.0 else 0.0}))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
