          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ventilation\" and r.metric == \"fan_speed\")\n  |> aggregateWindow(every: 5m, fn: count, createEmpty: true)\n  |> map(fn: (r) => ({_time: r._time, \"Lüftung\": if r._value > 0 then 1.0 else 0.0}))"
        }
