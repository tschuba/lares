    {
      "type": "stat",
      "title": "PV Erzeugung",
      "description": "Tatsächliche PV-Erzeugung (Inverter-Ausgang − Heimspeicher-Entladung) → Energie",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-nas"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "green",
                "value": 1000
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "PV",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "import \"array\"\n\nacPower = (from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"sungrow\" and r[\"_field\"] == \"total_active_power\")\n  |> last() |> findRecord(fn: (key) => true, idx: 0))._value\n\nbattPower = (from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"sungrow\" and r[\"_field\"] == \"battery_power\")\n  |> last() |> findRecord(fn: (key) => true, idx: 0))._value\n\nbattCharging = (from(bucket: v.defaultBucket)\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"sungrow\" and r[\"_field\"] == \"state_battery_charging\")\n  |> last() |> findRecord(fn: (key) => true, idx: 0))._value\n\npvPower = if battCharging == 1.0 then acPower + battPower else (if acPower > battPower then acPower - battPower else 0.0)\n\narray.from(rows: [{_time: now(), _value: pvPower, _field: \"pv_gesamt\", _measurement: \"sungrow\"}])"
        }
      ]
    },
