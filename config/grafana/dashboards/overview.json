      "targets": [
        {
          "refId": "FanSpeed",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -10m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"ventilation\")\n  |> filter(fn: (r) => r[\"metric\"] == \"fan_speed\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> last()\n  |> map(fn: (r) => ({r with _field: \"fan_speed\"}))\n  |> yield(name: \"last\")"
        },
        {
          "refId": "CO2",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
