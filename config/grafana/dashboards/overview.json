          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -10m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"ventilation\")\n  |> filter(fn: (r) => r[\"metric\"] == \"co2_level\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> last()\n  |> map(fn: (r) => ({r with _field: \"co2_level\"}))\n  |> yield(name: \"last\")"
        },
        {
          "refId": "Filter",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -10m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"ventilation\")\n  |> filter(fn: (r) => r[\"metric\"] == \"remaining_filter_days\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> last()\n  |> map(fn: (r) => ({r with _field: \"remaining_filter_days\"}))\n  |> yield(name: \"last\")"
        },
        {
          "refId": "HeatingIndoor",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-nas"
          },
          "query": "outdoor = from(bucket: v.defaultBucket)\n  |> range(start: -10m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"ventilation\")\n  |> filter(fn: (r) => r[\"metric\"] == \"temperature_outdoor_air\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"outdoor\"})\n\nindoor = from(bucket: v.defaultBucket)\n  |> range(start: -10m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"ventilation\")\n  |> filter(fn: (r) => r[\"metric\"] == \"temperature_extract_air\")\n  |> filter(fn: (r) => r[\"_field\"] == \"value\")\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> rename(columns: {_value: \"indoor\"})\n\njoin(tables: {outdoor: outdoor, indoor: indoor}, on: [\"_time\"])\n  |> map(fn: (r) => ({_time: r._time, _value: r.outdoor - r.indoor}))\n  |> last()\n  |> yield(name: \"last\")"
        }
      ]
