# Environment Variables Template for Lares
# Copy this file to .env and replace placeholders with actual values.
# See docs/inventar.md for a full list of placeholders.

# --- Network ---
PI_LAN_IP=192.168.1.x
NAS_LAN_IP=192.168.1.x

# --- MQTT Broker (Mosquitto on NAS) ---
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# --- InfluxDB (on NAS) ---
INFLUX_HOST=${NAS_LAN_IP}
INFLUX_USERNAME=your_influx_username
INFLUX_PASSWORD=your_influx_password
INFLUX_ORG=lares
INFLUX_BUCKET=smart_home
INFLUX_TOKEN=your_influx_admin_token

# --- Meross (profile: meross) ---
# Einmalig beim ersten Start fuer Device-Discovery via Meross Cloud API verwendet.
# Danach vollstaendig lokale Kommunikation. Siehe docs/konfiguration.md.
MEROSS_EMAIL=
MEROSS_PASSWORD=

# --- Sungrow (profile: sungrow) ---
# SUNGROW_IP=192.168.1.x

# --- Luxtronik / Novelan Waermepumpe (profile: heating) ---
# NOVELAN_IP=192.168.1.x

# --- Vallox Lueftungsanlage (profile: ventilation) ---
# VALLOX_IP=192.168.1.x

# --- Ecowitt (profile: weather) ---
# ECOWITT_PUSH_TARGET=http://${NAS_LAN_IP}:4004

# --- Weather Underground (profile: weather) ---
# WUNDERGROUND_STATION_ID=
# WUNDERGROUND_API_KEY=

# --- AWEKAS (profile: weather) ---
# AWEKAS_USERNAME=
# AWEKAS_PASSWORD=
# AWEKAS_STATION_ID=

# --- Windy.com (profile: weather) ---
# WINDY_STATION_ID=
# WINDY_API_KEY=

# --- CWOP/APRS (profile: weather) ---
# CWOP_STATION_ID=
# CWOP_PASSWORD=

# --- OpenWeatherMap (profile: weather) ---
# OPENWEATHER_STATION_ID=
# OPENWEATHER_API_KEY=
