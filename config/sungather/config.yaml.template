# SunGather Configuration for Lares (ADR-013)
# Modbus-only access to Sungrow inverter via modbus-proxy

# Inverter configuration
inverter:
  host: modbus-proxy
  port: 502
  slave: 0x01
  connection: modbus
  level: 2
  smart_meter: false
  scan_interval: 5

# Export configuration
exports:
  # MQTT export for Home Assistant integration
  - name: mqtt
    enabled: true
    host: mosquitto
    port: 1883
    # MQTT authentication (set to empty if disabled)
    username: "$MQTT_USERNAME"
    password: "$MQTT_PASSWORD"
    # Topic prefix
    topic: energy/sungrow
    # Home Assistant auto-discovery
    homeassistant: true
    ha_device_name: Sungrow Inverter
    ha_sensors: []

  # Optional: Web server for local monitoring
  # - name: webserver
  #   enabled: false
  #   port: 8080

# Logging configuration
log:
  # Log level: DEBUG, INFO, WARNING, ERROR
  level: INFO
  # Log to file (optional)
  # file: /logs/sungather.log
